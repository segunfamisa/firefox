# Each test renders the same file with the corresponding WebRender SVG pref on
# (test) and off (reference), so that the native WebRender rendering is
# compared against the blob image rendering. Fuzz accounts for anti-aliasing
# differences between WebRender and Skia.

defaults pref(gfx.webrender.blob.largeish-px,0) pref(gfx.webrender.blob.relaxed-active-threshold,true)

test-pref(gfx.webrender.svg-shapes.ellipses,true) ref-pref(gfx.webrender.svg-shapes.ellipses,false) fuzzy(0-80,0-2200) == shapes-ellipses.svg shapes-ellipses.svg
test-pref(gfx.webrender.svg-shapes.strokes,true) ref-pref(gfx.webrender.svg-shapes.strokes,false) test-pref(gfx.webrender.svg-shapes.ellipses,true) ref-pref(gfx.webrender.svg-shapes.ellipses,false) fuzzy(0-110,0-13377) == shapes-strokes.svg shapes-strokes.svg
