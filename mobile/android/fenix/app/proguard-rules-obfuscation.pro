# Everything obfuscation needs, applied only under `-PenableObfuscation` (bug 1987619).
#
# Without the flag none of this is read and the build is exactly what we ship today which applies `-dontobfuscate`
####################################################################################################
# REQUIRED: navigation graph argument types
####################################################################################################
#
# Classes named by `app:argType` in res/navigation/*.xml are resolved with `Class.forName()` when
# the graph is inflated. aapt generates keep rules for the `android:name` destinations but not for
# argument types, so obfuscating these is a fatal crash before the home screen renders
-keepnames class java.security.cert.X509Certificate { *; }
-keepnames class mozilla.components.browser.state.state.content.PermissionHighlightsState { *; }
-keepnames class mozilla.components.concept.engine.permission.SitePermissions { *; }
-keepnames class mozilla.components.concept.engine.prompt.ShareData { *; }
-keepnames class mozilla.components.concept.engine.translate.ModelState { *; }
-keepnames class mozilla.components.concept.engine.webextension.InstallationMethod { *; }
-keepnames class mozilla.components.concept.storage.Address { *; }
-keepnames class mozilla.components.concept.storage.CreditCard { *; }
-keepnames class mozilla.components.feature.addons.Addon { *; }
-keepnames class org.mozilla.fenix.collections.SaveCollectionStep { *; }
-keepnames class org.mozilla.fenix.components.accounts.FenixFxAEntryPoint { *; }
-keepnames class org.mozilla.fenix.components.menu.MenuAccessPoint { *; }
-keepnames class org.mozilla.fenix.components.metrics.MetricsUtils$Source { *; }
-keepnames class org.mozilla.fenix.ipprotection.store.Surface { *; }
-keepnames class org.mozilla.fenix.library.history.History { *; }
-keepnames class org.mozilla.fenix.pbmlock.NavigationOrigin { *; }
-keepnames class org.mozilla.fenix.settings.PhoneFeature { *; }
-keepnames class org.mozilla.fenix.tabstray.redux.state.Page { *; }
-keepnames class org.mozilla.fenix.tabstray.ui.AccessPoint { *; }
-keepnames class org.mozilla.fenix.termsofuse.store.Surface { *; }
-keepnames class org.mozilla.fenix.trackingprotection.TrackingProtectionMode { *; }
-keepnames class org.mozilla.fenix.translations.preferences.downloadlanguages.DownloadLanguageItemTypePreference { *; }
-keepnames class org.mozilla.fenix.translations.TranslationsDialogAccessPoint { *; }

####################################################################################################
# EXEMPTIONS: the migration backlog
####################################################################################################
#
# Fenix code is name-preserved by default while we find out what is actually safe to rename.
# The lines with a leading `!` are the classes that we know are safe to obfuscate
-keep,allowshrinking,allowoptimization class
    !androidx.**,
    ** { *; }

# Keeping everything means nothing is shrunk, so references that R8 previously discarded now have
# to resolve. These two are optional compile-time annotations that never ship. Generated by AGP
# into outputs/mapping/<variant>/missing_rules.txt.
-dontwarn com.google.android.gms.common.annotation.NoNullnessRewrite
-dontwarn com.google.firebase.ktx.Firebase
# Debug-only: an annotation from a test dependency that never ships.
-dontwarn org.mockito.DoNotMock
