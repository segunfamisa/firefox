# Keep rules for the androidTest APK, applied via `testProguardFiles`.
#
# AGP runs R8 over the androidTest APK whenever the app under test is minified, passing
# `-applymapping` against the app's mapping so the test code's references to app classes follow the
# obfuscated names. Nothing here ships, so the aim is to disturb that rewrite as little as possible.
#
# Do NOT use a blanket `-keep class ** { *; }`. Renaming under `-applymapping` is all-or-nothing per
# virtual method, and pinning names on one half of an override set that straddles the app/test
# boundary produces AbstractMethodError at runtime. `-dontshrink` keeps everything without blocking
# any rename, which is what we actually want. The app side of that same problem is handled by
# FUNCTION_INVOKE_RULE in AndroidTestKeepRulesPlugin.
-dontshrink
-dontoptimize

# AndroidJUnitRunner resolves test classes and test methods by their source names
# (`-e class org.mozilla.fenix.ui.BookmarksTest#deleteBookmarkFoldersTest`), so those names have to
# survive -- but only those. Everything else, including the lambdas in test code that implement the
# mapped `Function0`, must stay free to be renamed.
-keepnames class org.mozilla.fenix.**
-keepclassmembernames class org.mozilla.fenix.** {
    @org.junit.Test <methods>;
}
-keepattributes *

# Classes declared in the androidTest manifest must keep their names. AGP rewrites the *app*
# manifest to follow the mapping, but not the androidTest one -- the merged library manifests
# (androidx.test:core, androidx.benchmark) still name these with their source names, so a renamed
# class becomes an unresolvable component:
#
#   RuntimeException: Unable to resolve activity for:
#     Intent { act=android.intent.action.MAIN cmp=org.mozilla.fenix.test/z33 }
#     at androidx.test.core.app.InstrumentationActivityInvoker.startActivity
#
# Under `-applymapping` R8 usually leaves un-mapped classes alone, so this only bites when a name
# collides with one the app's mapping already claimed. That makes it intermittent and dependent on
# unrelated changes to the app -- pin the names rather than rely on luck.
-keepnames class * extends android.app.Activity
-keepnames class * extends android.app.Application
-keepnames class * extends android.app.Service
-keepnames class * extends android.content.BroadcastReceiver
-keepnames class * extends android.content.ContentProvider

# Test-only dependencies (mockk, byte-buddy, JNA, LeakCanary, the accessibility test framework)
# reference JVM-, Windows- and JUnit5-only APIs that are absent on Android. Generated by AGP into
# outputs/mapping/<variant>AndroidTest/missing_rules.txt.
-dontwarn android.support.v4.app.Fragment
-dontwarn android.support.v4.app.FragmentActivity
-dontwarn android.support.v4.app.FragmentManager$FragmentLifecycleCallbacks
-dontwarn android.support.v4.app.FragmentManager
-dontwarn androidx.work.multiprocess.RemoteListenableWorker
-dontwarn com.google.protobuf.GeneratedMessageLite$MergeFromVisitor
-dontwarn com.google.protobuf.GeneratedMessageLite$Visitor
-dontwarn com.sun.jna.platform.win32.Advapi32
-dontwarn com.sun.jna.platform.win32.Advapi32Util
-dontwarn com.sun.jna.platform.win32.Kernel32
-dontwarn com.sun.jna.platform.win32.Win32Exception
-dontwarn com.sun.jna.platform.win32.WinBase$OVERLAPPED
-dontwarn com.sun.jna.platform.win32.WinBase$SECURITY_ATTRIBUTES
-dontwarn com.sun.jna.platform.win32.WinDef$DWORD
-dontwarn com.sun.jna.platform.win32.WinDef$LPVOID
-dontwarn com.sun.jna.platform.win32.WinNT$ACCESS_ALLOWED_ACE
-dontwarn com.sun.jna.platform.win32.WinNT$ACL
-dontwarn com.sun.jna.platform.win32.WinNT$HANDLE
-dontwarn com.sun.jna.platform.win32.WinNT$PSID
-dontwarn com.sun.jna.platform.win32.WinNT$SECURITY_DESCRIPTOR
-dontwarn edu.umd.cs.findbugs.annotations.SuppressFBWarnings
-dontwarn java.awt.Component
-dontwarn java.awt.Window
-dontwarn java.lang.instrument.ClassDefinition
-dontwarn java.lang.instrument.ClassFileTransformer
-dontwarn java.lang.instrument.IllegalClassFormatException
-dontwarn java.lang.instrument.Instrumentation
-dontwarn java.lang.instrument.UnmodifiableClassException
-dontwarn org.junit.jupiter.api.TestInstance$Lifecycle
-dontwarn org.junit.jupiter.api.extension.AfterAllCallback
-dontwarn org.junit.jupiter.api.extension.AfterEachCallback
-dontwarn org.junit.jupiter.api.extension.ExtensionContext
-dontwarn org.junit.jupiter.api.extension.ParameterContext
-dontwarn org.junit.jupiter.api.extension.ParameterResolver
-dontwarn org.junit.jupiter.api.extension.TestInstancePostProcessor
-dontwarn org.slf4j.Logger
-dontwarn org.slf4j.LoggerFactory
# kotlin-reflect (via mockk) references reflection APIs that are not all present on Android. Kept
# even though kotlin-reflect is now packaged again, since the missing pieces are the same either way.
-dontwarn kotlin.reflect.full.**
-dontwarn kotlin.reflect.jvm.**
